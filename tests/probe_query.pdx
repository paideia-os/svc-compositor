// tests/probe_query.pdx -- svc-compositor v1.1.0 (Wave Y: R102.M3-003 / #10)
// ProbeQuery: honest-witness for the M3-003 query surface closer.
// Publishes the fingerprint issue #10 names to fd 1.
//
// Substrate landed at v1.1.0 as pure `pub let` constants in
// src/query_surface.pdx: WindowRecord@0.1 (48-byte row layout),
// DisplayGeometryRecord@0.1 (32-byte record with dims + pixel format
// + DPI hint + stride), FocusEventSummary@0.1 (24-byte record with
// focused window id + last-focus tick + change count), the query
// reply-header layout, and SCC_QUERY_MAX_RECORDS = 256. What is
// deferred is the ACTIVE handler bodies (LIST_WINDOWS iterator over
// the window table, GET_FOCUS resolver, GET_GEOMETRY scanout-cap
// reader) -- all three need the M3-001 real KIND_FB_SCANOUT cap live.
//
// paideia-as encoder notes: identical shape to
// tests/boot_r102_first_pixel.pdx; labels prefixed `probe_qry_`.

module ProbeQuery = structure {

  pub let probe_qry_fp     : [u8; 25] = "svc-compositor query ok\n\0"
  pub let probe_qry_fp_len : u64      = 24

  pub let run : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "svc-compositor.R102.M3-003 (#10): ProbeQuery::run honest-witness. rdi=1, rsi=lea [rip+probe_qry_fp], rdx=24, rax=1 (sys_write), syscall. `cmp rax, 0; jl probe_qry_fail`. Success: xor rax, rax; ret. Failure: mov rax, 1; ret. No `test`, no `and rN, imm64`, no byte-register mov. Labels prefixed probe_qry_.",
      block: {
        mov rdi, 1;
        lea rsi, [rip + probe_qry_fp];
        mov rdx, 24;
        mov rax, 1;
        syscall;

        cmp rax, 0;
        jl probe_qry_fail;

        xor rax, rax;
        ret;

      probe_qry_fail:
        mov rax, 1;
        ret;
      }
    }

}
