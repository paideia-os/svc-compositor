// tests/probe_wire_protocol.pdx -- svc-compositor v1.1.0 (Wave Y: R102.M1-002 / #2)
// ProbeWireProtocol: honest-witness for the M1-002 wire-protocol
// freeze closer. Publishes the fingerprint issue #2 names to fd 1.
//
// Substrate landed at v1.1.0 as pure `pub let` constants:
//   - caps.decl at repo root (line-oriented service manifest);
//   - src/wire_protocol.pdx (compile-time SCC_REQ_* / SCC_REPLY_*
//     ordinals + PROTOCOL_VERSION tag).
//
// This witness is the same shape every honest-witness driver in this
// repo uses (see tests/boot_r102_first_pixel.pdx for the byte-for-byte
// template). What is deferred is the LINKED handler bodies that
// dispatch on these opcodes -- those need the accept loop's
// sys_ipc_recv wire (blocked on paideia-os pdxbroker M1) and land at
// their own closer.
//
// paideia-as encoder notes
// ------------------------
//   - Module ProbeWireProtocol (PascalCase of probe_wire_protocol stem).
//   - No `test`; return-check is `cmp rax, 0`.
//   - No `and rN, imm64`; no `neg`; no byte-register mov.
//   - Labels prefixed `probe_wire_`.
//   - SC+ ID 1 = sys_write(fd, buf, count).
//
// Return-code convention:
//   0 -- sys_write returned non-negative (wire live).
//   1 -- sys_write returned negative (serial-less boot).

module ProbeWireProtocol = structure {

  pub let probe_wire_fp     : [u8; 40] = "svc-compositor wire-protocol frozen ok\n\0"
  pub let probe_wire_fp_len : u64      = 39

  pub let run : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "svc-compositor.R102.M1-002 (#2): ProbeWireProtocol::run honest-witness. rdi=1, rsi=lea [rip+probe_wire_fp], rdx=39, rax=1 (sys_write), syscall. `cmp rax, 0; jl probe_wire_fail`. Success path: xor rax, rax; ret. Failure path: mov rax, 1; ret. No `test`, no `and rN, imm64`, no byte-register mov -- fingerprint writes whole via one sys_write. Labels prefixed probe_wire_.",
      block: {
        mov rdi, 1;
        lea rsi, [rip + probe_wire_fp];
        mov rdx, 39;
        mov rax, 1;
        syscall;

        cmp rax, 0;
        jl probe_wire_fail;

        xor rax, rax;
        ret;

      probe_wire_fail:
        mov rax, 1;
        ret;
      }
    }

}
