// tests/probe_commit_message_decode.pdx -- svc-compositor v1.4.0
// (Wave OOO: SVC-CO-03)
// ProbeCommitMessageDecode: a second, independent real-body witness
// for Commit::commit_surface_handle (src/commit.pdx, #7), exercising
// a different surface_id / rect than tests/probe_commit.pdx's own
// (surface_id=5, x=10,y=20,w=30,h=40) so the per-surface damage
// table's slot-index arithmetic (surface_id * 4) is proven at a
// nontrivial, non-adjacent slot (168, not 20) rather than only ever
// re-checking the same table row.
//
// paideia-as encoder notes: identical fingerprint syscall shape to
// tests/boot_r102_first_pixel.pdx; labels prefixed `probe_cmd_`.

module ProbeCommitMessageDecode = structure {

  pub let probe_cmd_fp     : [u8; 41] = "svc-compositor commit-message-decode ok\n\0"
  pub let probe_cmd_fp_len : u64      = 40

  pub let mut _probe_cmd_msg : [u8; 24] = uninit @align(8)

  pub let run : () -> u64 !{mem, sysreg} @{} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "svc-compositor.WaveOOO (SVC-CO-03): ProbeCommitMessageDecode::run. Builds a well-formed 24-byte COMMIT_SURFACE message (kind=2 SCC_REQ_COMMIT_SURFACE, surface_id=42, x=10, y=20, w=100, h=200, buffer_ptr=0xFEEDFACECAFEBEEF -- a recognizable never-dereferenced test marker, distinct from probe_commit.pdx's own 0x1234567890ABCDEF) into _probe_cmd_msg via `mov [mem],e_` 32-bit stores + `mov_w [mem],r_` 16-bit stores + a `mov [mem],r_` 64-bit store -- identical field-encoding idiom to tests/probe_commit.pdx. Calls commit_surface_handle (external symbol, src/commit.pdx) with rdi = the message address; asserts rax==0 (CMT_OK). Re-reads _cmt_damage_table (external symbol) at slot index surface_id*4=168 (a different, non-adjacent slot than probe_commit.pdx's index=20, proving the slot-index arithmetic generalizes rather than only ever being checked at one fixed offset) and asserts dirty_flag==1, xy==10|(20<<32), wh==100|(200<<32), buffer_ptr==0xFEEDFACECAFEBEEF -- an exact round-trip check. Any assertion failure short-circuits to probe_cmd_fail (rax=1, no fingerprint emitted). No test rN,rN; no and rN,imm64; no byte-register mov (u16 fields go through mov_w, zero-extending). Labels prefixed probe_cmd_.",
      block: {
        lea r10, [rip + _probe_cmd_msg];

        mov eax, 2;
        mov [r10 + 0], eax;                  // kind = SCC_REQ_COMMIT_SURFACE
        mov eax, 42;
        mov [r10 + 4], eax;                  // surface_id = 42

        mov rax, 10;
        mov_w [r10 + 8], rax;                // x = 10
        mov rax, 20;
        mov_w [r10 + 10], rax;               // y = 20
        mov rax, 100;
        mov_w [r10 + 12], rax;               // w = 100
        mov rax, 200;
        mov_w [r10 + 14], rax;               // h = 200

        mov rax, 0xFEEDFACECAFEBEEF;
        mov [r10 + 16], rax;                 // buffer_ptr (test marker)

        mov rdi, r10;
        call commit_surface_handle;
        cmp rax, 0;
        jne probe_cmd_fail;

        mov r9, 42;
        shl r9, 2;                           // r9 = 168 (slot u64-index)
        lea r11, [rip + _cmt_damage_table];

        mov rax, [r11 + r9*8 + 0];           // dirty_flag
        cmp rax, 1;
        jne probe_cmd_fail;

        mov rax, [r11 + r9*8 + 8];           // xy
        mov r8, 20;
        shl r8, 32;
        mov r10, 10;
        or  r10, r8;                          // expected xy
        cmp rax, r10;
        jne probe_cmd_fail;

        mov rax, [r11 + r9*8 + 16];          // wh
        mov r8, 200;
        shl r8, 32;
        mov r10, 100;
        or  r10, r8;                          // expected wh
        cmp rax, r10;
        jne probe_cmd_fail;

        mov rax, [r11 + r9*8 + 24];          // buffer_ptr
        mov r10, 0xFEEDFACECAFEBEEF;
        cmp rax, r10;
        jne probe_cmd_fail;

        mov rdi, 1;
        lea rsi, [rip + probe_cmd_fp];
        mov rdx, 40;
        mov rax, 1;
        syscall;

        cmp rax, 0;
        jl probe_cmd_fail;

        xor rax, rax;
        ret;

      probe_cmd_fail:
        mov rax, 1;
        ret;
      }
    }

}
